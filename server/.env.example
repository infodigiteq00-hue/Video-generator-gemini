# Get a key at https://aistudio.google.com/apikey (billing must be enabled for Veo)
GEMINI_API_KEY=
# Video model: Gemini Omni Flash (~$0.10 per second at 720p)
VIDEO_MODEL=gemini-omni-1.1-flash
# Image model: gemini-3.1-flash-image (Nano Banana 2, ~$0.067/image, default)
# or gemini-3.1-flash-lite-image (Nano Banana 2 Lite, ~$0.034/image)
IMAGE_MODEL=gemini-3.1-flash-image
API_PORT=8787

# ---- ChatGPT app (MCP) ----
# Secret path segment: the MCP URL becomes https://<public-host>/mcp/<MCP_TOKEN>
MCP_TOKEN=
# Public URL of this server (tunnel / hosting). Optional: detected from request headers if empty.
PUBLIC_URL=
# Force a provider for ChatGPT calls: veo-3.1-lite or mock (default: veo if a key is set)
MCP_PROVIDER=

# ---- Admin account (customers sign up on the website; this one sees Customers and can mark payments) ----
AUTH_EMAIL=
# Generate with: node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" YOUR_PASSWORD
AUTH_PASSWORD_HASH=
# Random secret that signs login sessions: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- Online payments: PhonePe Payment Gateway (Digiteq Solutions account) ----
# Without these the funnel shows a placeholder QR and an admin confirms each payment under Customers.
# From the PhonePe Business Dashboard → Developer Settings. Start with the UAT/sandbox credentials.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# sandbox (default) or production
PHONEPE_ENV=sandbox
# Webhook: URL <PUBLIC_URL>/api/pay/webhook, with this username and password (PhonePe signs with SHA256 of user:pass).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Meta Conversions API: each confirmed sale is also reported to Meta from the server (the app's pixel sends it too,
# with the same event ID, so it counts once). Token: Events Manager → Digiteq Studio pixel → Settings → Conversions API
# → Generate access token. Leave empty to rely on the browser pixel only.
META_CAPI_ACCESS_TOKEN=
# Defaults to the Digiteq Studio pixel (2077330492969198).
# META_PIXEL_ID=
# While testing: the code from Events Manager → Test Events, so test sales show there instead of counting.
# META_TEST_EVENT_CODE=

# ---- Serving under a path of another site (www.quotegen.ai/digiteqstudio, see docs/QUOTEGEN_PROXY.md) ----
BASE_PATH=
